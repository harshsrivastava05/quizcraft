// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id    String  @id @default(auto()) @map("_id") @db.ObjectId // MongoDB ObjectId for primary key
  email String  @unique

  // Relations
  files    File[]    @relation("UserFiles")
  messages Message[] @relation("UserMessages")

  // Stripe-related fields
  stripeCustomerId       String?   @unique @map(name: "stripe_customer_id")
  stripeSubscriptionId   String?   @unique @map(name: "stripe_subscription_id")
  stripePriceId          String?   @map(name: "stripe_price_id")
  stripeCurrentPeriodEnd DateTime? @map(name: "stripe_current_period_end")
}

model File {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId // MongoDB ObjectId
  name         String
  url          String
  key          String
  uploadStatus UploadStatus @default(PENDING)
  
  // Relation to User
  userId String  @db.ObjectId
  user   User    @relation("UserFiles", fields: [userId], references: [id])

  // Relation to messages
  messages Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Message {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId // MongoDB ObjectId
  content      String    
  isUserMessage Boolean

  // Relation to User
  userId  String  @db.ObjectId
  user    User    @relation("UserMessages", fields: [userId], references: [id])

  // Relation to File
  fileId  String? @db.ObjectId
  file    File?   @relation(fields: [fileId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum UploadStatus {
  PENDING
  PROCESSING
  FAILED
  SUCCESS
}
